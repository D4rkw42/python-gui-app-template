{
    "build": {
        "productKey": {
            "layout": {
                "bytes": [2, 1, 3, 2],
                "separator": "-",
                "format": "hex"
            },
            "signature": {
                "algorithm": "sha256",
                "format": "base64"
            }
        },
        "salt": {
            "layout": {
                "bytes": 16,
                "format": "base64"
            }
        }
    }
}